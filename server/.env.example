# Database (hỗ trợ 1 trong 2 cách: individual fields hoặc DATABASE_URL)
DB_HOST="gateway01.ap-northeast-1.prod.aws.tidbcloud.com"
DB_PORT=4000
DB_USER="xxx.root"
DB_PASSWORD="xxx"
DB_NAME="yourlife_db"
DB_SSL=true
# Hoặc dùng DATABASE_URL:
# DATABASE_URL="mysql://user:pass@host:4000/yourlife_db?ssl={\"rejectUnauthorized\":true}"

# Server
PORT=3000
JWT_SECRET="your-super-secret-key-change-this"
NODE_ENV="development"

# Cloudflare R2
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET_NAME="yourlife-storage"
R2_PUBLIC_DOMAIN="https://pub-xxx.r2.dev"

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="xxx"
VAPID_PRIVATE_KEY="xxx"
VAPID_EMAIL="mailto:your@email.com"
